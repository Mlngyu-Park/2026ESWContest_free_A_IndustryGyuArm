Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 12
      Reference Frame: board
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.15
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Name: cam_grid
      Enabled: true
      Topic:
        Value: /cam_grid/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Camera
      Name: camera view (1st person)
      Enabled: true
      Topic:
        Value: /cam_grid/image
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Image Rendering: background and overlay
      Overlay Alpha: 0.5
      Zoom Factor: 1
  Global Options:
    Fixed Frame: board
    Background Color: 48; 48; 48
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point: {X: 0.29, Y: 0.29, Z: 0.15}
      Pitch: 0.6
      Yaw: 3.9
Window Geometry:
  Width: 1400
  Height: 900
